{
  "name": "powder-chaser",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Japan ski resort powder forecasts and trip decisions.",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build && node scripts/stamp-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "icons": "node scripts/generate-icons.mjs",
    "images": "node scripts/optimize-images.mjs",
    "catalogue:import": "node scripts/import-japan-resorts.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
